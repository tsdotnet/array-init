{
  "name": "@tsdotnet/array-init",
  "version": "1.3.1",
  "description": "Commonly used array initializer that optimizes for length.",
  "author": "electricessence",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/arrayInit.js",
  "module": "./dist/esm/arrayInit.js",
  "exports": {
    ".": {
      "module-sync": {
        "types": "./dist/types/arrayInit.d.ts",
        "default": "./dist/esm/arrayInit.js"
      },
      "module": {
        "types": "./dist/types/arrayInit.d.ts",
        "default": "./dist/esm/arrayInit.js"
      },
      "import": {
        "types": "./dist/types/arrayInit.d.ts",
        "default": "./dist/esm/arrayInit.js"
      },
      "require": {
        "types": "./dist/cjs/arrayInit.d.ts",
        "default": "./dist/cjs/arrayInit.js"
      },
      "default": {
        "types": "./dist/types/arrayInit.d.ts",
        "default": "./dist/esm/arrayInit.js"
      }
    },
    "./package.json": "./package.json",
    "./umd": {
      "types": "./dist/cjs/arrayInit.d.ts",
      "default": "./dist/umd/array-init.js"
    }
  },
  "types": "./dist/types/arrayInit.d.ts",
  "unpkg": "./dist/umd/array-init.min.js",
  "jsdelivr": "./dist/umd/array-init.min.js",
  "keywords": [
    "array",
    "array helper",
    "array utility",
    "array init",
    "array initialization"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "copy:dts": "cpy \"src/**/*.d.ts\" dist/types --parents || echo No .d.ts files to copy",
    "copy:dts:cjs": "cpy \"src/**/*.d.ts\" dist/cjs --parents || echo No .d.ts files to copy",
    "build:types": "pnpm copy:dts && node ./node_modules/typescript-native/bin/tsc -p tsconfig.types.json",
    "build:esm": "rollup -c rollup.config.js",
    "build:umd": "rollup -c rollup.umd.config.js",
    "build:cjs": "node ./node_modules/typescript-native/bin/tsc -p tsconfig.cjs.json && pnpm copy:dts:cjs && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "build": "pnpm clean && pnpm build:types && pnpm build:esm && pnpm build:umd && pnpm build:cjs && pnpm typecheck:tests",
    "test": "vitest run",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "typecheck:tests": "node ./node_modules/typescript-native/bin/tsc -p tests/tsconfig.json --noEmit",
    "lint": "eslint src/**/*.ts",
    "docs": "rimraf docs && typedoc --options typedoc.json --readme none",
    "bump": "pnpm run precommit && pnpm version patch",
    "precommit": "pnpm build && pnpm test && pnpm lint && git status -s",
    "preversion": "pnpm lint && pnpm test",
    "postversion": "git push && git push --tags && pnpm run docs && git add -A && git commit -m \"Updated docs.\" docs && git push",
    "prepublishOnly": "pnpm build && pnpm test && pnpm lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsdotnet/array-init.git"
  },
  "bugs": {
    "url": "https://github.com/tsdotnet/array-init/issues"
  },
  "homepage": "https://github.com/tsdotnet/array-init#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.15.0",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.7",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "tslib": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1",
      "typedoc>minimatch": "^10.2.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-g3hv-75wg-m249"
      ]
    }
  }
}
